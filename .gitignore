# ═══════════════════════════════════════════════
#  Brio .gitignore
# ═══════════════════════════════════════════════

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Logs (don't commit these — they grow large)
*.log
brio_safeguard.log
brio_startup.log

# Runtime state & memory
brio_state.json
brio_engrams.json
brio_milestones.json
brio_memory_simple.json
brio_health.json
brio_memory_db/
vision_cache/
console_output.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Agent
.agent/
