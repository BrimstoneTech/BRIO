# BRIM AI Environment Configuration

# API Configuration
BRIM_API_PORT=8000
BRIM_API_HOST=0.0.0.0
BRIM_ENV=development # development | production

# Database
BRIM_DB_PATH=brim_interactions.db

# Security
# Secret key for JWT or session signing (Change this in production!)
BRIM_SECRET_KEY=change_this_to_a_random_secure_string

# Feature Flags
ENABLE_DEBUG_LOGS=true
ENABLE_PROVERBS=true
